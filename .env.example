# Copy to .env and replace both secrets before starting.
SECRET_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.31.2,truenas,recipes.pechatov.com,gotovka.pechatov.com
CSRF_TRUSTED_ORIGINS=http://192.168.31.2:30111,https://recipes.pechatov.com,https://gotovka.pechatov.com
TIME_ZONE=Europe/Moscow
# Nginx Proxy Manager terminates HTTPS and sends X-Forwarded-Proto.
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Optional AI provider. Any trusted OpenAI-compatible /v1 endpoint works.
# Keep the key empty for local providers that do not require authentication.
RECIPE_AI_BASE_URL=
RECIPE_AI_API_KEY=
RECIPE_AI_MODEL=
RECIPE_AI_TIMEOUT_SECONDS=120

# Separate Hermes profile with browser-only tools for cart assembly.
CART_AI_BASE_URL=
CART_AI_API_KEY=
CART_AI_MODEL=recipes-cart-sol
CART_AI_TIMEOUT_SECONDS=900
CART_MAX_PARALLEL_AGENTS=5
CART_CONFIRMATION_MINUTES=180

WEB_PORT=30111
RECIPES_DATA_PATH=./data
POSTGRES_DATA_PATH=./postgres-data
